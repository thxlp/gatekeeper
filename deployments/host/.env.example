# Env ของ gatekeeper บน host (systemd EnvironmentFile) — copy เป็น .env แล้วเติมค่าจริง
# ค่า secret ชุดเดียวกับ deployments/docker/.env เดิม (ดู README.md ข้อ 2 มี snippet generate ให้)
# หมายเหตุ systemd: ห้ามมี quote รอบค่า และไม่ expand ${VAR} — ต้องเป็นค่าตรงๆ ทุกบรรทัด

# --- secrets (ค่าเดียวกับ deployments/docker/.env เดิม) ---
COOKIE_CHALLENGE_SECRET=
GATEKEEPER_TICKET_SECRET=
GATEKEEPER_MASTER_KEY=
# DATABASE_URL ต้องประกอบเอง: postgres://gatekeeper:<POSTGRES_PASSWORD>@127.0.0.1:5432/gatekeeper
DATABASE_URL=

# --- Supabase (backend ใช้ SUPABASE_*, ส่วน NEXT_PUBLIC_* ใช้ตอน build frontend) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- ค่าคงที่ของ deployment นี้ ---
FRONTEND_URL=https://studiodup.com
PUBLIC_LIVE_URL=https://live.studiodup.com
# host ของ live origin (ไม่มี scheme/port) — ใช้ 2 ที่: เช็ค DNS ของ custom domain ว่า CNAME
# มาหาเราจริงก่อนออก cert (domain.service.ts) และเป็น allowlist ของ LiveController ที่ยอมเสิร์ฟ
# /live/<id> เฉพาะ origin นี้ ตั้งให้ตรงกับ host ใน PUBLIC_LIVE_URL เสมอ
LIVE_ORIGIN_HOST=live.studiodup.com

# docker-socket-proxy (container, publish loopback) — อย่าชี้ /var/run/docker.sock ตรง
DOCKER_HOST=127.0.0.1
DOCKER_PORT=2375
GATEKEEPER_APPS_NETWORK=gatekeeper-apps-net

# รันบน host: ปิดการ network-connect ตัวเอง (docker-runtime.service.ts HOST_MODE)
GATEKEEPER_HOST_MODE=1
# bind loopback เท่านั้น — กัน tenant container ยิงเข้า backend ผ่าน bridge gateway IP
BIND_HOST=127.0.0.1

# path ฝั่ง host (เดิมใน container คือ /app) — ต้องเป็น repo root: DATA_DIR = <ROOT>/data และ
# CONFIGS_DIR = <ROOT>/configs (secret-patterns.json อยู่ที่ configs/ ระดับ repo ไม่ใช่ใน backend/)
GATEKEEPER_ROOT=/home/dup/gatekeeper
AUDIT_LOG_PATH=/home/dup/gatekeeper/data/audit.log

# โควต้าทรัพยากรรวมต่อ user (เพดานผลรวม limit แบบ overcommit)
# หารพูลรวมเท่าๆ กัน: พูลเดิมฐาน 30 user (30×256 MB / 30×0.5 CPU) = 7680 MB / 15 CPU
# แบ่งใหม่ให้ 15 user → 512 MB / 1 CPU ต่อคน (เครื่องจริง 1CPU/2GB จึงเป็นเพดาน ไม่ใช่การจอง)
USER_QUOTA_MEMORY_MB=512
USER_QUOTA_CPU=1

# --- ฟีเจอร์ 2FA (ยืนยันตัวตนสองขั้นตอนด้วยรหัสทางอีเมล) ---
# ค่าเริ่มต้น = ปิดปรับปรุง ต้องตั้ง FEATURE_2FA=1 เท่านั้นถึงจะเปิดใช้งาน
# ปิดอยู่ = login ข้ามขั้นตอนกรอกรหัสไปเลยแม้บัญชีจะเปิด 2FA ค้างไว้ (ค่าใน DB ไม่ถูกแตะ
# เปิดกลับมาเมื่อไหร่ก็บังคับเหมือนเดิม) และ endpoint เปิด/ปิด 2FA ตอบ 503 ทั้งหมด
# ⚠ ก่อนตั้งเป็น 1 ต้องมั่นใจว่าเมล "ส่งออกได้จริง" ไม่ใช่แค่ตั้งค่าไว้ — เมลส่งไม่ออก
#   = ทุกคนที่เปิด 2FA เข้าระบบไม่ได้ทันที (ดู docs/INCIDENT-2026-08-08-2fa-mail.md)
#FEATURE_2FA=1

# --- อีเมล (notification + OTP 2FA) ---
# เว้นว่างทั้งหมด = ระบบข้ามการส่งเมล (log warn) — in-app notification ยังทำงานปกติ
# แต่จะเปิด 2FA ไม่ได้จนกว่าช่องทางส่งเมลจะพร้อม (fail-closed) และถ้าส่งไม่ออกจริง
# login ของบัญชีที่เปิด 2FA จะตอบ 503 แทนที่จะพาไปหน้ากรอกรหัสที่ไม่มีรหัสมาถึง
#
# MAIL_FROM ต้องตั้งเสมอไม่ว่าโหมดไหน
MAIL_FROM=
#
# เลือกช่องทาง: smtp | http — ไม่ตั้ง = เดาเอง (มี MAIL_API_KEY → http, ไม่มี → smtp)
#MAIL_TRANSPORT=
#
# โหมด smtp — SMTP_PORT: 587 = STARTTLS (default), 465 = TLS ตรง, 2525 = ทางเลี่ยงเวลาโฮสต์
# บล็อกพอร์ต SMTP มาตรฐาน (Brevo/SendGrid/Mailgun รองรับ 2525 — Gmail ไม่รองรับ)
# ⚠ โฮสต์หลายเจ้าบล็อก outbound 25/465/587 เป็นค่าเริ่มต้น เช็คก่อนด้วย:
#     node -e "require('net').connect({host:'smtp.gmail.com',port:587}).on('connect',()=>console.log('OK')).on('error',e=>console.log(e.code))"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
#
# โหมด http — ยิง REST API ผ่าน 443 ใช้ได้แม้พอร์ต SMTP ถูกบล็อก
# MAIL_HTTP_PROVIDER: resend (default) | brevo
#MAIL_HTTP_PROVIDER=resend
#MAIL_API_KEY=

# จำนวน release/image ย้อนหลังต่อ app ที่เก็บไว้ให้ rollback (default 5)
#RELEASE_KEEP=5

# Env ของ gatekeeper บน host (systemd EnvironmentFile) — copy เป็น .env แล้วเติมค่าจริง
# ค่า secret ชุดเดียวกับ deployments/docker/.env เดิม (ดู README.md ข้อ 2 มี snippet generate ให้)
# หมายเหตุ systemd: ห้ามมี quote รอบค่า และไม่ expand ${VAR} — ต้องเป็นค่าตรงๆ ทุกบรรทัด

# --- secrets (ค่าเดียวกับ deployments/docker/.env เดิม) ---
COOKIE_CHALLENGE_SECRET=
GATEKEEPER_TICKET_SECRET=
GATEKEEPER_MASTER_KEY=
# DATABASE_URL ต้องประกอบเอง: postgres://gatekeeper:<POSTGRES_PASSWORD>@127.0.0.1:5432/gatekeeper
DATABASE_URL=

# --- Supabase (backend ใช้ SUPABASE_*, ส่วน NEXT_PUBLIC_* ใช้ตอน build frontend) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- ค่าคงที่ของ deployment นี้ ---
FRONTEND_URL=https://studiodup.com
PUBLIC_LIVE_URL=https://live.studiodup.com

# docker-socket-proxy (container, publish loopback) — อย่าชี้ /var/run/docker.sock ตรง
DOCKER_HOST=127.0.0.1
DOCKER_PORT=2375
GATEKEEPER_APPS_NETWORK=gatekeeper-apps-net

# รันบน host: ปิดการ network-connect ตัวเอง (docker-runtime.service.ts HOST_MODE)
GATEKEEPER_HOST_MODE=1
# bind loopback เท่านั้น — กัน tenant container ยิงเข้า backend ผ่าน bridge gateway IP
BIND_HOST=127.0.0.1

# path ฝั่ง host (เดิมใน container คือ /app) — ต้องเป็น repo root: DATA_DIR = <ROOT>/data และ
# CONFIGS_DIR = <ROOT>/configs (secret-patterns.json อยู่ที่ configs/ ระดับ repo ไม่ใช่ใน backend/)
GATEKEEPER_ROOT=/home/dup/gatekeeper
AUDIT_LOG_PATH=/home/dup/gatekeeper/data/audit.log

# โควต้าทรัพยากรรวมต่อ user (เพดานผลรวม limit แบบ overcommit) — เฉลี่ยจากเครื่อง 1CPU/2GB / ~20 user
USER_QUOTA_MEMORY_MB=256
USER_QUOTA_CPU=0.5

# --- อีเมล (notification + OTP 2FA) ผ่าน SMTP ทั่วไป ---
# เว้นว่างทั้งหมด = ระบบข้ามการส่งเมล (log warn) — in-app notification ยังทำงานปกติ
# แต่จะเปิด 2FA ไม่ได้จนกว่า SMTP จะพร้อม (fail-closed)
# SMTP_PORT: 587 = STARTTLS (default), 465 = TLS ตรง
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# จำนวน release/image ย้อนหลังต่อ app ที่เก็บไว้ให้ rollback (default 5)
#RELEASE_KEEP=5
